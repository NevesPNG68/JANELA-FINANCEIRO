<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>Janela • Inteligência Financeira</title>
<style>
:root{
 --bg:#06111c;--bg2:#091724;--panel:#0c1b2a;--panel2:#102235;--panel3:#142a40;
 --line:#20364b;--line2:#2d4a65;--text:#f5f8fb;--muted:#91a6ba;--muted2:#667f97;
 --blue:#4aa3ff;--green:#2bd47d;--red:#ff5d58;--amber:#ffad3f;--purple:#a279ff;--cyan:#32c4d8;
 --series-net:#5ba8ff;--series-fixed:#ff8a3d;--series-cmv:#22c7c9;--series-variable:#b092ff;--series-period:#38bdf8;--series-compare:#fbbf24;
 --shadow:0 18px 48px rgba(0,0,0,.24);--r:16px;
}
body.light{
 --bg:#f3f6fa;--bg2:#eaf0f6;--panel:#ffffff;--panel2:#f6f9fc;--panel3:#edf3f8;
 --line:#d8e1ea;--line2:#c4d0dc;--text:#132132;--muted:#61758a;--muted2:#8292a3;
 --blue:#1677d2;--green:#15965a;--red:#d74642;--amber:#d98512;--purple:#7356d8;--cyan:#1496aa;
 --series-net:#2563eb;--series-fixed:#c2410c;--series-cmv:#0e7490;--series-variable:#7c3aed;--series-period:#0284c7;--series-compare:#d97706;
 --shadow:0 14px 36px rgba(40,62,84,.10);
 background:radial-gradient(circle at 58% -10%,#dcecff 0,transparent 34%),var(--bg);
}
body.light .sidebar{background:linear-gradient(180deg,#ffffff,#edf3f8);border-right-color:var(--line)}
body.light .nav a{color:#536a80}body.light .nav a:hover{background:#e7f0f9;color:#16283a}
body.light .nav a.active{background:linear-gradient(135deg,#e7f1fb,#dcebf8);color:#173f63;box-shadow:inset 0 0 0 1px #c5dcef,0 5px 14px rgba(42,87,126,.1)}
body.light .side-meta,body.light .seg,body.light .selectbox{background:#ffffff}
body.light .selectbox select{color:#203449}body.light .selectbox option{background:#fff;color:#203449}
body.light .seg button.active{background:#d8e9f8;color:#17324b}
body.light .card,body.light .panel{background:linear-gradient(180deg,#ffffff,#f8fbfd)}
body.light .gauge:after{background:#ffffff;box-shadow:inset 0 0 18px rgba(35,60,86,.08)}
body.light .insight,body.light .cost-kpi,body.light .monthtile{background:#f7fafc}
body.light .meter,body.light .bar,body.light .group-track{background:#e4ebf2}body.light .group-summary>div{background:#f7fafc}
body.light .dre th,body.light .dre-matrix th:first-child,body.light .dre-matrix td:first-child{background:#f1f5f9}
body.light .dre-matrix .section-row td{background:#e9f2fa;color:#21384d}
body.light .mobile-nav{background:rgba(255,255,255,.96)}
body.light .insight p{color:#607589}
body.light .side-meta b{color:#263c50}
body.light .kpi label{color:#61758a}
body.light .theme-toggle{background:#fff;color:#23384c}
*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--bg)}body{margin:0;background:radial-gradient(circle at 58% -10%,#102d4d 0,transparent 33%),var(--bg);color:var(--text);font-family:Inter,"Segoe UI",Roboto,Arial,sans-serif;font-variant-numeric:tabular-nums;line-height:1.35}
button,select{font:inherit}button{cursor:pointer}.app{min-height:100vh}.sidebar{position:fixed;inset:0 auto 0 0;width:210px;padding:24px 14px 18px;background:linear-gradient(180deg,#071521,#06111c);border-right:1px solid var(--line);z-index:30;display:flex;flex-direction:column}.brand{padding:4px 9px 25px}.brand .name{font-size:27px;font-weight:950;letter-spacing:-.8px}.brand .sub{margin-top:4px;color:#f5b923;font-weight:900;font-size:10px;letter-spacing:3px}.nav{display:grid;gap:5px}.nav a{color:#9eb0c2;text-decoration:none;display:flex;align-items:center;gap:11px;padding:10px 11px;border-radius:10px;font-size:12px;font-weight:700;transition:.15s}.nav a:hover{background:#11263a;color:#fff}.nav a.active{background:linear-gradient(135deg,#1476d7,#329bff);color:#fff;box-shadow:0 8px 26px rgba(47,143,255,.25)}.nav .ico{width:18px;text-align:center}.side-meta{margin-top:auto;border:1px solid var(--line);background:#091a29;border-radius:12px;padding:11px;font-size:9.5px;color:var(--muted);line-height:1.6}.side-meta b{color:#dfeaf3}.live{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--green);margin-right:6px;box-shadow:0 0 0 3px rgba(43,212,125,.12)}
.main{margin-left:210px;padding:22px 22px 48px;max-width:1900px}.topbar{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;margin-bottom:13px}.topbar h1{font-size:21px;margin:0 0 5px;font-weight:900;letter-spacing:-.25px}.topbar p{margin:0;color:var(--muted);font-size:10.5px}.controls{display:flex;gap:8px;align-items:center;justify-content:flex-end;flex-wrap:wrap}.seg{display:flex;border:1px solid var(--line);background:#0a1b2a;border-radius:10px;padding:3px}.seg button{border:0;background:transparent;color:var(--muted);padding:7px 10px;border-radius:7px;font-size:10px;font-weight:800}.seg button.active{background:#173653;color:#fff}.selectbox{display:flex;align-items:center;gap:6px;border:1px solid var(--line);background:#0a1b2a;padding:5px 7px;border-radius:10px}.selectbox span{color:var(--muted);font-size:9px}.selectbox select{border:0;background:transparent;color:#eaf1f7;font-size:10px;outline:none}.selectbox option{background:#0c1b2a}.theme-toggle{width:36px;height:36px;border:1px solid var(--line);background:#0a1b2a;color:#eaf1f7;border-radius:10px;display:grid;place-items:center;font-size:15px;box-shadow:var(--shadow);transition:.15s}.theme-toggle:hover{transform:translateY(-1px)}
.partial-badge{display:inline-flex;align-items:center;margin-left:4px;padding:1px 5px;border:1px solid rgba(255,173,63,.4);border-radius:999px;background:rgba(255,173,63,.1);color:#ffc16a;font-size:7px;font-weight:900;letter-spacing:.2px;text-transform:uppercase;white-space:nowrap}.partial-flags{display:flex;flex-wrap:wrap;gap:3px;margin-top:5px}.partial-flags .partial-badge{margin-left:0}body.light .partial-badge{background:#fff3dc;color:#99600c;border-color:#e4b65e}
.grid-top{display:grid;grid-template-columns:190px repeat(5,minmax(150px,1fr));gap:10px;margin-bottom:10px}.card,.panel{background:linear-gradient(180deg,rgba(14,31,48,.98),rgba(9,22,35,.98));border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow)}.scorecard{padding:13px;min-height:156px;display:flex;flex-direction:column;align-items:center}.card-label{align-self:flex-start;font-size:9px;letter-spacing:.6px;color:var(--muted);font-weight:850;text-transform:uppercase}.gauge{width:104px;height:104px;border-radius:50%;display:grid;place-items:center;position:relative;margin:1px 0 -3px}.gauge:after{content:"";position:absolute;width:76px;height:76px;border-radius:50%;background:#0d1d2c;box-shadow:inset 0 0 20px rgba(0,0,0,.36)}.gauge-inner{z-index:1;text-align:center}.gauge-inner b{display:block;font-size:31px;line-height:1;font-weight:950}.gauge-inner small{font-size:9px;color:var(--muted)}.score-status{font-size:10px;font-weight:950;letter-spacing:.7px}.score-help{margin-top:2px;color:var(--muted2);font-size:8.5px;text-align:center}.kpi{padding:13px;min-height:156px;display:flex;flex-direction:column}.kpi label{font-size:9px;color:#a8b9c8;text-transform:uppercase;font-weight:850;letter-spacing:.45px}.kpi .value{font-size:20px;font-weight:950;margin:9px 0 4px;white-space:nowrap}.kpi .delta{font-size:9.5px;font-weight:800}.delta.good{color:var(--green)}.delta.bad{color:#ff7670}.delta.neutral{color:var(--muted)}.kpi .detail{color:var(--muted2);font-size:8.8px;margin-top:3px}.spark{height:34px;margin-top:auto}.spark svg{width:100%;height:100%;overflow:visible}.section{scroll-margin-top:12px;margin-top:10px}.panel{padding:13px}.panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:7px}.panel h2{font-size:12.5px;margin:0;letter-spacing:.1px}.panel p{font-size:9.5px;color:var(--muted);margin:3px 0 0}.badge{padding:4px 7px;border:1px solid var(--line);border-radius:999px;color:var(--muted);font-size:8.8px;white-space:nowrap}.grid-main{display:grid;grid-template-columns:minmax(0,2.35fr) minmax(280px,.85fr);gap:10px}.plot-main{height:425px}.plot-ratio{height:305px}.plot-donut{height:245px}.plot-pay{height:230px}.plot{width:100%;min-width:0}.insights{display:grid;gap:8px}.insight{border:1px solid var(--line);background:#0d2031;border-radius:12px;padding:10px;display:grid;grid-template-columns:30px 1fr;gap:9px}.insight .ii{width:30px;height:30px;border-radius:9px;display:grid;place-items:center;font-size:13px}.ii.good{background:rgba(43,212,125,.12);color:var(--green)}.ii.bad{background:rgba(255,93,88,.12);color:#ff7771}.ii.warn{background:rgba(255,173,63,.12);color:#ffc16a}.ii.info{background:rgba(74,163,255,.12);color:#77baff}.insight b{font-size:10.5px}.insight p{font-size:9.5px;color:#b2c1cf;margin:3px 0 0;line-height:1.42}.mini-status{margin-top:9px;border-top:1px solid var(--line);padding-top:9px;display:grid;gap:8px}.status-row{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:center}.status-row span{font-size:9.2px;color:var(--muted)}.status-row b{font-size:10px}.meter{height:5px;background:#132a3e;border-radius:999px;overflow:hidden;margin-top:4px}.meter i{display:block;height:100%;border-radius:inherit}.grid-3{display:grid;grid-template-columns:1fr 1.6fr 1fr;gap:10px}.cost-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:5px}.cost-kpi{border:1px solid var(--line);background:#0b1e2f;border-radius:10px;padding:8px}.cost-kpi span{font-size:8.3px;color:var(--muted)}.cost-kpi b{display:block;font-size:13px;margin-top:3px}.cost-kpi small{font-size:8px;color:var(--muted2)}.list{display:grid;gap:7px}.list-row{display:grid;grid-template-columns:minmax(90px,1fr) 1.2fr auto;gap:8px;align-items:center}.list-row .name{font-size:9.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar{height:6px;background:#13293c;border-radius:999px;overflow:hidden}.bar i{display:block;height:100%;border-radius:999px}.list-row b{font-size:9.5px;white-space:nowrap}.list-row small{font-size:8px;color:var(--muted2)}.group-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:10px 0}.group-summary>div{border:1px solid var(--line);background:#0b1e2f;border-radius:10px;padding:8px}.group-summary span{display:block;color:var(--muted);font-size:8px}.group-summary b{display:block;margin-top:3px;font-size:11px;white-space:nowrap}.group-legend{display:flex;gap:12px;color:var(--muted);font-size:8px;margin:0 0 5px}.group-legend i{display:inline-block;width:12px;height:4px;border-radius:99px;margin-right:4px;vertical-align:middle}.group-legend .period{background:var(--series-period)}.group-legend .compare{background:repeating-linear-gradient(135deg,var(--series-compare) 0 3px,transparent 3px 5px);border:1px solid var(--series-compare)}.group-list{gap:0}.group-row{padding:8px 0;border-top:1px solid rgba(32,54,75,.65)}.group-row-head,.group-values{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:center}.group-row-head .name{font-size:9.5px;font-weight:850}.group-delta{font-size:8.5px;font-weight:850;white-space:nowrap}.group-values{margin-top:4px}.group-values span{font-size:8px;color:var(--muted)}.group-values b{font-size:9px;color:var(--text);margin-left:4px}.group-bars{display:grid;gap:3px;margin-top:5px}.group-track{height:5px;background:#13293c;border-radius:999px;overflow:hidden}.group-track i{display:block;height:100%;border-radius:inherit}.group-track .period{background:var(--series-period)}.group-track .compare{background:repeating-linear-gradient(135deg,var(--series-compare) 0 4px,transparent 4px 7px);border:1px solid var(--series-compare)}.dre td.good,.group-delta.good{color:var(--green)!important}.dre td.bad,.group-delta.bad{color:#ff7670!important}.dre td.neutral,.group-delta.neutral{color:var(--muted)!important}.grid-bottom{display:grid;grid-template-columns:1.3fr 1.05fr .9fr;gap:10px}.dre-wrap{overflow:auto;border:1px solid var(--line);border-radius:11px}.dre{width:100%;border-collapse:collapse;font-size:9.4px;min-width:650px}.dre th,.dre td{padding:7px 8px;border-bottom:1px solid rgba(32,54,75,.8);text-align:right;white-space:nowrap}.dre th{color:var(--muted);background:#0b1d2d;font-weight:750}.dre th:first-child,.dre td:first-child{text-align:left}.dre tr:last-child td{border-bottom:0}.dre .total td{font-weight:900}.dre-matrix{min-width:1050px;font-size:9.2px}.dre-matrix th:first-child,.dre-matrix td:first-child{position:sticky;left:0;z-index:2;background:#0b1d2d;box-shadow:1px 0 0 var(--line);min-width:165px}.dre-matrix thead th:first-child{z-index:4}.dre-matrix .section-row td{background:#10283d;color:#dce7f0;font-weight:900}.dre-matrix .subtotal td{font-weight:850;background:rgba(74,163,255,.045)}.dre-matrix .profit-row td{font-weight:950;border-top:1px solid var(--line2);border-bottom:1px solid var(--line2)}.dre-full{margin-bottom:10px}.dre-note{margin-top:8px;color:var(--muted);font-size:9px;line-height:1.5}.pos{color:var(--green)!important}.neg{color:#ff6e68!important}.heatmap{display:grid;grid-template-columns:repeat(auto-fit,minmax(94px,1fr));gap:6px}.monthtile{border:1px solid var(--line);border-radius:10px;padding:8px;background:#0b1d2d}.monthtile .m{font-size:8.8px;color:var(--muted);font-weight:800}.monthtile .rev{font-size:10.5px;font-weight:850;margin-top:5px}.monthtile .ll{font-size:9px;margin-top:3px;font-weight:800}.monthtile .mg{font-size:8px;color:var(--muted2);margin-top:2px}.details{margin-top:9px}.details details{border-top:1px solid var(--line);padding-top:8px}.details summary{cursor:pointer;color:var(--muted);font-size:9px}.details div{color:#9fb0bf;font-size:8.8px;line-height:1.45;padding-top:6px}.footer{color:var(--muted2);font-size:8.5px;text-align:center;margin-top:16px}.mobile-nav{display:none}
@media(max-width:1350px){.grid-top{grid-template-columns:180px repeat(3,1fr)}.grid-top .kpi:nth-last-child(-n+2){grid-column:span 1}.grid-main{grid-template-columns:1fr}.grid-3{grid-template-columns:1fr 1fr}.grid-3>div:last-child{grid-column:1/-1}.grid-bottom{grid-template-columns:1fr 1fr}.grid-bottom>div:first-child{grid-column:1/-1}}
@media(max-width:900px){.sidebar{display:none}.main{margin-left:0;padding:14px 11px 70px}.mobile-nav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:40;background:rgba(6,17,28,.96);backdrop-filter:blur(10px);border-top:1px solid var(--line);padding:7px;justify-content:space-around}.mobile-nav a{font-size:9px;color:var(--muted);text-decoration:none;text-align:center}.topbar{flex-direction:column}.controls{justify-content:flex-start}.grid-top{grid-template-columns:1fr 1fr}.scorecard{grid-row:span 2}.grid-3,.grid-bottom{grid-template-columns:1fr}.grid-3>div:last-child,.grid-bottom>div:first-child{grid-column:auto}.grid-bottom>div{min-width:0}.dre-wrap{max-width:100%}.plot-main{height:390px}.plot-ratio{height:300px}}
@media(max-width:560px){.grid-top{grid-template-columns:1fr 1fr}.kpi .value{font-size:17px}.topbar h1{font-size:18px}.seg button{padding:6px 8px}.selectbox{width:100%}.selectbox select{flex:1}.plot-main{height:420px}.cost-kpis{grid-template-columns:1fr}.grid-main{gap:8px}.panel{padding:10px}.heatmap{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="brand"><div class="name">JANELA</div><div class="sub">FINANCEIRO</div></div>
  <nav class="nav">
    <a href="#visao" class="active"><span class="ico">◈</span>Visão Geral</a>
    <a href="#evolucao"><span class="ico">⌁</span>Evolução</a>
    <a href="#custos"><span class="ico">◎</span>Custos</a>
    <a href="#detalhes"><span class="ico">▦</span>Detalhes</a>
    <a href="#dre"><span class="ico">≣</span>DRE</a>
  </nav>
  <div class="side-meta"><span class="live"></span><b>Base carregada</b><br><span id="sideBase"></span></div>
</aside>
<main class="main">
  <header class="topbar">
    <div><h1>Inteligência Financeira</h1><p id="headline">Leitura executiva da saúde financeira do Janela.</p></div>
    <div class="controls">
      <div class="seg" id="presetSeg"><button data-preset="ytd" class="active">ACUM. ANO</button><button data-preset="6">6M</button><button data-preset="12">12M</button><button data-preset="all">Tudo</button></div>
      <div class="selectbox"><span>DE</span><select id="startSel"></select><span>ATÉ</span><select id="endSel"></select></div>
      <div class="selectbox"><span>COMPARAR</span><select id="compareSel"><option value="yoy">Ano anterior</option><option value="previous">Período anterior</option></select></div>
      <button class="theme-toggle" id="themeToggle" type="button" title="Alternar t
