r=>r.gross,total:t.gross,cls:'section-row'},
  {name:'(-) Deduções / Taxas',fn:deductions,total:totalDeductions},
  {name:'RECEITA LÍQUIDA',fn:r=>r.net,total:t.net,cls:'subtotal'},
  {name:'(-) CMV',fn:r=>r.cmv,total:t.cmv},
  {name:'LUCRO BRUTO',fn:grossProfit,total:totalGrossProfit,cls:'subtotal'},
  {name:'(-) Custos Fixos',fn:r=>r.fixed,total:t.fixed},
  {name:'(-) Despesas Variáveis',fn:r=>r.variable,total:t.variable},
  {name:'DESPESAS TOTAIS',fn:r=>r.expenses,total:t.expenses,cls:'subtotal'},
  {name:'LL / PJ',fn:r=>r.profit,total:t.profit,cls:'profit-row',profit:true},
  {name:'Margem Líquida',fn:r=>r.net?r.profit/r.net:0,total:t.margin,pct:true},
  {name:'CMV / Receita Líquida',fn:r=>r.net?r.cmv/r.net:0,total:t.cmvRatio,pct:true},
  {name:'MKP',fn:r=>r.mkp,total:t.cmv?t.gross/t.cmv:0,mkp:true},
  {name:'Fixo / Receita Líquida',fn:r=>r.net?r.fixed/r.net:0,total:t.fixedRatio,pct:true},
  {name:'Variável / Receita Líquida',fn:r=>r.net?r.variable/r.net:0,total:t.variableRatio,pct:true},
  {name:'Ponto de Equilíbrio',fn:r=>r.breakeven,total:null,pe:true}
 ];
 const cell=(v,row)=>{if(row.pct)return pct(v);if(row.mkp)return num(v,2);const cl=row.profit?(v>=0?'pos':'neg'):'';return `<span class="${cl}">${money(v,2)}</span>`};
 $('#dreMonthlyTable').innerHTML=`<thead><tr><th>CONTA</th>${headers}</tr></thead><tbody>${rowsMonthly.map(row=>{
   const vals=rs.map(r=>`<td>${cell(row.fn(r),row)}</td>`).join('');
   let totalCell;
   if(row.pe){const avg=rs.length?rs.reduce((s,r)=>s+r.breakeven,0)/rs.length:0;totalCell=`<td>${money(avg,2)} <span style="color:var(--muted);font-size:8px">média</span></td>`}
   else totalCell=`<td>${cell(row.total,row)}</td>`;
   return `<tr class="${row.cls||''}"><td>${row.name}</td>${vals}${totalCell}</tr>`
 }).join('')}</tbody>`;
 const rowsD=[['Receita Bruta',t.gross,c?.gross],['(-) Deduções / Taxas',totalDeductions,c?c.gross-c.net:null],['Receita Líquida',t.net,c?.net],['(-) CMV',t.cmv,c?.cmv],['Lucro Bruto',totalGrossProfit,c?c.net-c.cmv:null],['(-) Custos Fixos',t.fixed,c?.fixed],['(-) Despesas Variáveis',t.variable,c?.variable],['Despesas Totais',t.expenses,c?.expenses],['LL / PJ',t.profit,c?.profit]];
 $('#dreCompareText').textContent=cr.length?`Comparação com ${compLabel(rs,cr)}.`:'Sem período comparável completo.';
 $('#dreTable').innerHTML=`<thead><tr><th>Conta</th><th>Período</th><th>Comparável</th><th>Variação</th><th>% Receita Líq.</th></tr></thead><tbody>${rowsD.map(([n,v,cv])=>{const isLL=n==='LL / PJ',ratio=t.net?v/t.net:0,d=cv!=null?delta(v,cv):null,inverse=n.includes('Deduç')||n.includes('Custo')||n.includes('CMV')||n.includes('Despesa');return `<tr class="${isLL?'total':''}"><td>${n}</td><td class="${isLL?(v>=0?'pos':'neg'):''}">${money(v,2)}</td><td>${cv==null?'—':money(cv,2)}</td><td class="${d==null?'':cls(d,inverse)}">${d==null?'—':deltaText(d)}</td><td>${pct(ratio)}</td></tr>`}).join('')}</tbody>`;
 $('#monthMap').innerHTML=rs.map(r=>{const mg=r.net?r.profit/r.net:0,col=r.profit<0?'#ff5d58':mg>=.10?'#2bd47d':mg>=.05?'#ffad3f':'#f3cc55',flags=[r.receiptPartial?'Receita parcial':'',r.expensePartial?'Despesas parciais':''].filter(Boolean);return `<div class="monthtile" style="border-color:${col}55"><div class="m">${r.label}</div>${flags.length?`<div class="partial-flags">${flags.map(x=>`<span class="partial-badge">${x}</span>`).join('')}</div>`:''}<div class="rev">${compact(r.net)}</div><div class="ll" style="color:${col}">${r.profit>=0?'+':''}${compact(r.profit)}</div><div class="mg${r.profit<0?' neg':''}">LL ${pct(mg)}</div></div>`}).join('');
 const last=rs[rs.length-1],gap=last.net-last.breakeven,gapPct=last.breakeven?gap/last.breakeven:0,ok=gap>=0;
 $('#peBox').innerHTML=`<div style="font-size:24px;font-weight:950;color:${ok?'var(--green)':'var(--red)'}">${compact(Math.abs(gap))}</div><div style="font-size:10px;color:var(--muted);margin-top:4px">${ok?'de folga acima':'abaixo'} do ponto de equilíbrio em ${last.label}</div><div class="meter" style="height:9px;margin-top:13px"><i style="width:${Math.min(100,Math.max(0,last.net/Math.max(last.breakeven,1)*70))}%;background:${ok?'var(--green)':'var(--red)'}"></i></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:9px;color:var(--muted)"><span>PE ${compact(last.breakeven)}</span><span>Receita ${compact(last.net)}</span></div><div style="margin-top:10px;font-size:9.5px;color:#b4c2cf;line-height:1.45">A Receita Líquida ficou <b style="color:${ok?'var(--green)':'var(--red)'}">${pct(Math.abs(gapPct))}</b> ${ok?'acima':'abaixo'} do valor necessário para cobrir os custos fixos.</div>`
}
// Monthly values come from SINTETICO, exactly as in the DRE.
function gaussEscape(value){return String(value).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function gaussWindow(all,endKey,count,now=new Date()){
 const current=monthKeyFromDate(now),[year,month]=endKey.split('-').map(Number);
 const first=new Date(year,month-count,1),firstKey=monthKeyFromDate(first);
 return all.filter(r=>r.key>=firstKey&&r.key<=endKey&&r.key<current&&!r.receiptPartial&&Number.isFinite(r.net));
}
function gaussStats(rs){const n=rs.length,mean=n?sum(rs,'net')/n:0,sd=n>1?Math.sqrt(rs.reduce((s,r)=>s+(r.net-mean)**2,0)/(n-1)):0;return {n,mean,sd}}
let gaussObserver=null,gaussResizeObserver=null,gaussResizeWidth=0,gaussResizeTimer=null;
function gaussAnimate(){
 if(gaussObserver)gaussObserver.disconnect();
 const cards=[...document.querySelectorAll('.gauss-card')];
 cards.forEach(card=>card.classList.remove('gauss-visible'));
 if(!('IntersectionObserver' in window)){cards.forEach(card=>card.classList.add('gauss-visible'));return}
 gaussObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('gauss-visible');gaussObserver.unobserve(entry.target)}}),{threshold:.15});
 requestAnimationFrame(()=>cards.forEach(card=>gaussObserver.observe(card)));
}
function gaussCard(host,rs,count){
 const {n,mean,sd}=gaussStats(rs),blue=cssVar('--blue'),green=cssVar('--green'),red=cssVar('--red'),muted=cssVar('--muted'),line=cssVar('--line'),panel=cssVar('--panel');
 const color=v=>Math.abs(v-mean)<.005?blue:v>mean?green:red;
 const position=v=>Math.abs(v-mean)<.005?'Na média':v>mean?'Acima da média':'Abaixo da média';
 const last=rs[n-1],z=last&&sd?(last.net-mean)/sd:0;
 const title=`Últimos ${count} meses completos`;
 host.innerHTML=`<h3>${title}</h3><p class="gauss-subtitle">${n?gaussEscape(labelRange(rs)):'Sem meses completos'} · ${n} ${n===1?'observação':'observações'}${n<count?' · base incompleta':''}</p>`;
 if(!n){host.innerHTML+='<div class="gauss-empty">Sem dados completos nesta janela.</div>';return}
 host.innerHTML+=`<div class="gauss-stats"><div><span>Média mensal</span><b>${compact(mean)}</b></div><div><span>Desvio padrão</span><b>${compact(sd)}</b></div><div><span>Último mês · ${gaussEscape(last.label)}</span><b style="color:${color(last.net)}">${sd?num(z,2)+' σ':position(last.net)}</b></div></div>`;
 const width=Math.max(320,Math.round(host.clientWidth-28)),height=250,left=35,right=20,top=40,bottom=205;
 const spread=sd||Math.max(Math.abs(mean)*.08,1),min=Math.min(mean-3.2*spread,...rs.map(r=>r.net-spread*.15)),max=Math.max(mean+3.2*spread,...rs.map(r=>r.net+spread*.15));
 const x=v=>left+(v-min)/(max-min)*(width-left-right),y=v=>bottom-Math.exp(-.5*((v-mean)/spread)**2)*(bottom-top);
 const path=Array.from({length:161},(_,i)=>{const v=min+(max-min)*i/160;return `${i?'L':'M'}${x(v).toFixed(2)},${y(v).toFixed(2)}`}).join(' ');
 const area=path+` L${x(max)},${bottom} L${x(min)},${bottom} Z`;
 const bands=sd?`<rect x="${x(mean-sd)}" y="${top-8}" width="${x(mean+sd)-x(mean-sd)}" height="${bottom-top+8}" fill="${blue}" opacity=".07"/>`:'';
 const ticks=[mean-2*spread,mean-spread,mean,mean+spread,mean+2*spread].map(v=>`<line x1="${x(v)}" y1="${bottom}" x2="${x(v)}" y2="${bottom+4}" stroke="${line}"/><text x="${x(v)}" y="${bottom+19}" text-anchor="middle" font-size="9" fill="${muted}">${gaussEscape(compact(v))}</text>`).join('');
 const placed=[],points=rs.map((r,i)=>({r,i})).sort((a,b)=>a.r.net-b.r.net).map(({r,i})=>{
  const px=x(r.net),py=y(r.net);let cx=px,cy=Math.max(35,py-10);
  while(placed.some(p=>Math.abs(p.x-cx)<48&&Math.abs(p.y-cy)<21)){cy+=22;if(cy>bottom-14){cy=35;cx=Math.min(width-right-24,cx+50)}}
  placed.push({x:cx,y:cy});
  const tip=`${r.label} · ${money(r.net,2)} · ${position(r.net)}${sd?' · Z '+num((r.net-mean)/sd,2):''}`;
  // Alternate displaced markers and leaders keep close monthly values individually visible.
  const col=color(r.net);
  return `<g class="gauss-hit" tabindex="0" role="img" aria-label="${gaussEscape(tip)}"><title>${gaussEscape(tip)}</title><line x1="${px}" y1="${py}" x2="${cx}" y2="${cy}" stroke="${col}" stroke-width="1" opacity=".6"/><circle cx="${cx}" cy="${cy}" r="5" fill="${col}" stroke="${panel}" stroke-width="1.5"/><text x="${cx}" y="${cy-9}" text-anchor="middle" font-size="9" fill="${col}">${gaussEscape(r.label)}</text></g>`;
 }).join('');
 host.innerHTML+=`<svg class="gauss-chart" viewBox="0 0 ${width} ${height}" role="img" aria-label="Curva normal e ${n} meses reais de Receita Líquida"><text x="${left}" y="15" font-size="9" fill="${muted}">Densidade relativa</text>${bands}<line x1="${left}" x2="${width-right}" y1="${bottom}" y2="${bottom}" stroke="${line}"/>${ticks}<line x1="${x(mean)}" x2="${x(mean)}" y1="${top-8}" y2="${bottom}" stroke="${blue}" stroke-dasharray="4 4" opacity=".7"/><g class="gauss-growth">${sd?`<path d="${area}" fill="${blue}" opacity=".12"/><path d="${path}" fill="none" stroke="${blue}" stroke-width="2.5"/>`:''}</g><g class="gauss-labels">${points}</g><text x="${width/2}" y="${height-5}" text-anchor="middle" font-size="9" fill="${muted}">Receita Líquida mensal (R$)</text></svg>`;
 host.innerHTML+=`<div class="gauss-legend"><span><i style="background:${red}"></i>Abaixo da média</span><span><i style="background:${blue}"></i>Média</span><span><i style="background:${green}"></i>Acima da média</span></div><div class="gauss-months">${rs.map(r=>`<div class="gauss-month" tabindex="0" style="--point:${color(r.net)}" title="${gaussEscape(r.label+' · '+money(r.net,2)+' · '+position(r.net))}"><span>${gaussEscape(r.label)}</span><b>${money(r.net,0)}</b></div>`).join('')}</div>`;
 host.innerHTML+=`<div class="gauss-reading"><b>${gaussEscape(last.label)}</b>: <b>${money(last.net,2)}</b>, <b style="color:${color(last.net)}">${position(last.net).toLowerCase()}</b>${Math.abs(last.net-mean)>=.005?' em '+money(Math.abs(last.net-mean),2):''}.${n<=3?' Com apenas '+n+' meses, a curva é uma referência visual; a amostra é insuficiente para estimar probabilidades confiáveis.':' Curva normal ajustada à média e ao desvio padrão amostral; não comprova que as receitas seguem uma distribuição normal.'}${!sd?' Sem dispersão suficiente para traçar uma curva normal.':''}</div>`;
}
function renderGauss(){
 const selected=months[state.end];if(!selected)return;
 const now=new Date(),current=monthKeyFromDate(now);
 const eligible=months.filter(r=>r.key<=selected.key&&r.key<current&&!r.receiptPartial&&Number.isFinite(r.net));
 const end=eligible[eligible.length-1];
 $('#gaussPeriod').textContent=end?`Receita Líquida · janelas encerradas em ${end.label} · referência: mês final do filtro; o início do filtro não reduz o histórico.`:'Sem meses completos disponíveis até o mês final selecionado.';
 [12,3].forEach(n=>gaussCard($('#gauss'+n),end?gaussWindow(months,end.key,n,now):[],n));
 const partial=months.filter(r=>r.key<=selected.key&&(r.key===current||r.receiptPartial));
 $('#gaussPartial').textContent=partial.length?partial.map(r=>`${r.label}: ${money(r.net,2)} (parcial, fora das curvas)`).join(' · '):'Base: Receita Líquida mensal da aba SINTETICO, igual à DRE. Apenas meses completos, sem projeção.';
 $('#gaussReplay').onclick=()=>{document.querySelectorAll('.gauss-card').forEach(card=>{card.classList.remove('gauss-visible');void card.offsetWidth});gaussAnimate()};
 gaussAnimate();
 if(!gaussResizeObserver&&'ResizeObserver' in window){const block=$('#gauss');gaussResizeWidth=block.clientWidth;gaussResizeObserver=new ResizeObserver(entries=>{const w=Math.round(entries[0].contentRect.width);if(Math.abs(w-gaussResizeWidth)>2){gaussResizeWidth=w;clearTimeout(gaussResizeTimer);gaussResizeTimer=setTimeout(renderGauss,120)}});gaussResizeObserver.observe(block)}
}

function renderAll(){syncPlotTheme();const rs=rows(),t=totals(rs),cr=compRows(rs),c=cr.length?totals(cr):null;$('#periodBadge').textContent=labelRange(rs);$('#headline').textContent=`Saúde financeira • ${labelRange(rs)} • comparação: ${compLabel(rs,cr)}.`;renderTop(rs,t,cr,c);renderMainChart(rs);renderInsights(rs,t,cr,c);renderCost(rs,t);renderRatio(rs);renderDetails(rs,t,cr);renderLast(rs);renderDre(rs,t,cr,c);renderGauss();setTimeout(()=>window.dispatchEvent(new Event('resize')),100)}
function setPreset(p){state.preset=p;const last=months.length-1;if(p==='all'){state.start=0;state.end=last}else if(p==='ytd'){const y=months[last].key.slice(0,4);state.start=months.findIndex(r=>r.key.startsWith(y+'-01'));if(state.start<0)state.start=Math.max(0,last-6);state.end=last}else{const n=Number(p);state.start=Math.max(0,last-n+1);state.end=last}$$('#presetSeg button').forEach(b=>b.classList.toggle('active',b.dataset.preset===p));syncSelects();renderAll()}
function syncSelects(){$('#startSel').value=months[state.start].key;$('#endSel').value=months[state.end].key}
async function init(){try{const savedTheme=localStorage.getItem('janela-theme')||'dark';applyTheme(savedTheme,false);DATA=await loadDataFromExcel();months=DATA.months;byKey=Object.fromEntries(months.map(x=>[x.key,x]));const last=months.length-1;const y=months[last].key.slice(0,4);state.start=months.findIndex(r=>r.key.startsWith(y+'-01'));if(state.start<0)state.start=Math.max(0,last-6);state.end=last;$('#themeToggle').onclick=()=>applyTheme(isLight()?'dark':'light',true);const opts=months.map(r=>`<option value="${r.key}">${r.label}</option>`).join('');$('#startSel').innerHTML=opts;$('#endSel').innerHTML=opts;syncSelects();$('#compareSel').value=state.compare;const partialBadge=label=>`<span class="partial-badge">${label}</span>`;$('#sideBase').innerHTML=`Receita até <b>${DATA.latestReceipt}</b>${DATA.receiptPartial?partialBadge('Parcial'):''}<br>Despesas até <b>${DATA.latestExpense}</b>${DATA.expensePartial?partialBadge('Parcial'):''}<br>Último mês disponível: <b>${months[months.length-1].label}</b>`;$('#footerSource').textContent=DATA.source;$$('#presetSeg button').forEach(b=>b.onclick=()=>setPreset(b.dataset.preset));$('#startSel').onchange=()=>{let a=idx($('#startSel').value),b=idx($('#endSel').value);if(a>b)b=a;state.start=a;state.end=b;state.preset='custom';$$('#presetSeg button').forEach(x=>x.classList.remove('active'));syncSelects();renderAll()};$('#endSel').onchange=()=>{let a=idx($('#startSel').value),b=idx($('#endSel').value);if(b<a)a=b;state.start=a;state.end=b;state.preset='custom';$$('#presetSeg button').forEach(x=>x.classList.remove('active'));syncSelects();renderAll()};$('#compareSel').onchange=e=>{state.compare=e.target.value;renderAll()};const sections=$$('section[id]'),links=$$('.nav a');window.addEventListener('scroll',()=>{let cur='visao';for(const s of sections)if(s.getBoundingClientRect().top<150)cur=s.id;links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+cur))},{passive:true});renderAll()}catch(err){console.error(err);showLoadError(err)}}
init();
</script>
</body></html>
