:r=>r.gross,total:t.gross,cls:'section-row'},
  {name:'(-) Deduções / Taxas',fn:deductions,total:totalDeductions},
  {name:'RECEITA LÍQUIDA',fn:r=>r.net,total:t.net,cls:'subtotal'},
  {name:'(-) CMV',fn:r=>r.cmv,total:t.cmv},
  {name:'LUCRO BRUTO',fn:grossProfit,total:totalGrossProfit,cls:'subtotal'},
  {name:'(-) Custos Fixos',fn:r=>r.fixed,total:t.fixed},
  {name:'(-) Despesas Variáveis',fn:r=>r.variable,total:t.variable},
  {name:'DESPESAS TOTAIS',fn:r=>r.expenses,total:t.expenses,cls:'subtotal'},
  {name:'LL / PJ',fn:r=>r.profit,total:t.profit,cls:'profit-row',profit:true},
  {name:'Margem Líquida',fn:r=>r.net?r.profit/r.net:0,total:t.margin,pct:true},
  {name:'CMV / Receita Líquida',fn:r=>r.net?r.cmv/r.net:0,total:t.cmvRatio,pct:true},
  {name:'Fixo / Receita Líquida',fn:r=>r.net?r.fixed/r.net:0,total:t.fixedRatio,pct:true},
  {name:'Variável / Receita Líquida',fn:r=>r.net?r.variable/r.net:0,total:t.variableRatio,pct:true},
  {name:'Ponto de Equilíbrio',fn:r=>r.breakeven,total:null,pe:true}
 ];
 const cell=(v,row)=>{if(row.pct)return pct(v);const cl=row.profit?(v>=0?'pos':'neg'):'';return `<span class="${cl}">${money(v,2)}</span>`};
 $('#dreMonthlyTable').innerHTML=`<thead><tr><th>CONTA</th>${headers}</tr></thead><tbody>${rowsMonthly.map(row=>{
   const vals=rs.map(r=>`<td>${cell(row.fn(r),row)}</td>`).join('');
   let totalCell;
   if(row.pe){const avg=rs.length?rs.reduce((s,r)=>s+r.breakeven,0)/rs.length:0;totalCell=`<td>${money(avg,2)} <span style="color:var(--muted);font-size:8px">média</span></td>`}
   else totalCell=`<td>${cell(row.total,row)}</td>`;
   return `<tr class="${row.cls||''}"><td>${row.name}</td>${vals}${totalCell}</tr>`
 }).join('')}</tbody>`;
 const rowsD=[['Receita Bruta',t.gross,c?.gross],['(-) Deduções / Taxas',totalDeductions,c?c.gross-c.net:null],['Receita Líquida',t.net,c?.net],['(-) CMV',t.cmv,c?.cmv],['Lucro Bruto',totalGrossProfit,c?c.net-c.cmv:null],['(-) Custos Fixos',t.fixed,c?.fixed],['(-) Despesas Variáveis',t.variable,c?.variable],['Despesas Totais',t.expenses,c?.expenses],['LL / PJ',t.profit,c?.profit]];
 $('#dreCompareText').textContent=cr.length?`Comparação com ${compLabel(rs,cr)}.`:'Sem período comparável completo.';
 $('#dreTable').innerHTML=`<thead><tr><th>Conta</th><th>Período</th><th>Comparável</th><th>Variação</th><th>% Receita Líq.</th></tr></thead><tbody>${rowsD.map(([n,v,cv])=>{const isLL=n==='LL / PJ',ratio=t.net?v/t.net:0,d=cv!=null?delta(v,cv):null,inverse=n.includes('Deduç')||n.includes('Custo')||n.includes('CMV')||n.includes('Despesa');return `<tr class="${isLL?'total':''}"><td>${n}</td><td class="${isLL?(v>=0?'pos':'neg'):''}">${money(v,2)}</td><td>${cv==null?'—':money(cv,2)}</td><td class="${d==null?'':cls(d,inverse)}">${d==null?'—':deltaText(d)}</td><td>${pct(ratio)}</td></tr>`}).join('')}</tbody>`;
 $('#monthMap').innerHTML=rs.map(r=>{const mg=r.net?r.profit/r.net:0,col=r.profit<0?'#ff5d58':mg>=.10?'#2bd47d':mg>=.05?'#ffad3f':'#f3cc55';return `<div class="monthtile" style="border-color:${col}55"><div class="m">${r.label}</div><div class="rev">${compact(r.net)}</div><div class="ll" style="color:${col}">${r.profit>=0?'+':''}${compact(r.profit)}</div><div class="mg">LL ${pct(mg)}</div></div>`}).join('');
 const last=rs[rs.length-1],gap=last.net-last.breakeven,gapPct=last.breakeven?gap/last.breakeven:0,ok=gap>=0;
 $('#peBox').innerHTML=`<div style="font-size:24px;font-weight:950;color:${ok?'var(--green)':'var(--red)'}">${compact(Math.abs(gap))}</div><div style="font-size:10px;color:var(--muted);margin-top:4px">${ok?'de folga acima':'abaixo'} do ponto de equilíbrio em ${last.label}</div><div class="meter" style="height:9px;margin-top:13px"><i style="width:${Math.min(100,Math.max(0,last.net/Math.max(last.breakeven,1)*70))}%;background:${ok?'var(--green)':'var(--red)'}"></i></div><div style="display:flex;justify-content:space-between;margin-top:6px;font-size:9px;color:var(--muted)"><span>PE ${compact(last.breakeven)}</span><span>Receita ${compact(last.net)}</span></div><div style="margin-top:10px;font-size:9.5px;color:#b4c2cf;line-height:1.45">A Receita Líquida ficou <b style="color:${ok?'var(--green)':'var(--red)'}">${pct(Math.abs(gapPct))}</b> ${ok?'acima':'abaixo'} do valor necessário para cobrir os custos fixos.</div>`
}
function renderAll(){syncPlotTheme();const rs=rows(),t=totals(rs),cr=compRows(rs),c=cr.length?totals(cr):null;$('#periodBadge').textContent=labelRange(rs);$('#headline').textContent=`Saúde financeira • ${labelRange(rs)} • comparação: ${compLabel(rs,cr)}.`;renderTop(rs,t,cr,c);renderMainChart(rs);renderInsights(rs,t,cr,c);renderCost(rs,t);renderRatio(rs);renderDetails(rs,t);renderLast(rs);renderDre(rs,t,cr,c);setTimeout(()=>window.dispatchEvent(new Event('resize')),100)}
function setPreset(p){state.preset=p;const last=months.length-1;if(p==='all'){state.start=0;state.end=last}else if(p==='ytd'){const y=months[last].key.slice(0,4);state.start=months.findIndex(r=>r.key.startsWith(y+'-01'));if(state.start<0)state.start=Math.max(0,last-6);state.end=last}else{const n=Number(p);state.start=Math.max(0,last-n+1);state.end=last}$$('#presetSeg button').forEach(b=>b.classList.toggle('active',b.dataset.preset===p));syncSelects();renderAll()}
function syncSelects(){$('#startSel').value=months[state.start].key;$('#endSel').value=months[state.end].key}
async function init(){try{const savedTheme=localStorage.getItem('janela-theme')||'dark';applyTheme(savedTheme,false);DATA=await loadDataFromExcel();months=DATA.months;byKey=Object.fromEntries(months.map(x=>[x.key,x]));const last=months.length-1;const y=months[last].key.slice(0,4);state.start=months.findIndex(r=>r.key.startsWith(y+'-01'));if(state.start<0)state.start=Math.max(0,last-6);state.end=last;$('#themeToggle').onclick=()=>applyTheme(isLight()?'dark':'light',true);const opts=months.map(r=>`<option value="${r.key}">${r.label}</option>`).join('');$('#startSel').innerHTML=opts;$('#endSel').innerHTML=opts;syncSelects();$('#compareSel').value=state.compare;$('#sideBase').innerHTML=`Receita até <b>${DATA.latestReceipt}</b><br>Despesas até <b>${DATA.latestExpense}</b><br>Último mês fechado: <b>${months[months.length-1].label}</b>`;$('#footerSource').textContent=DATA.source;$('#warnText').textContent=`Receitas atualizadas até ${DATA.latestReceipt}; Despesas até ${DATA.latestExpense}. O painel usa como meses fechados os meses consolidados na aba SINTETICO.`;$$('#presetSeg button').forEach(b=>b.onclick=()=>setPreset(b.dataset.preset));$('#startSel').onchange=()=>{let a=idx($('#startSel').value),b=idx($('#endSel').value);if(a>b)b=a;state.start=a;state.end=b;state.preset='custom';$$('#presetSeg button').forEach(x=>x.classList.remove('active'));syncSelects();renderAll()};$('#endSel').onchange=()=>{let a=idx($('#startSel').value),b=idx($('#endSel').value);if(b<a)a=b;state.start=a;state.end=b;state.preset='custom';$$('#presetSeg button').forEach(x=>x.classList.remove('active'));syncSelects();renderAll()};$('#compareSel').onchange=e=>{state.compare=e.target.value;renderAll()};const sections=$$('section[id]'),links=$$('.nav a');window.addEventListener('scroll',()=>{let cur='visao';for(const s of sections)if(s.getBoundingClientRect().top<150)cur=s.id;links.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+cur))},{passive:true});renderAll()}catch(err){console.error(err);showLoadError(err)}}
init();
</script>
</body></html>