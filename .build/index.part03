theme==='light');localStorage.setItem('janela-theme',theme);const btn=document.getElementById('themeToggle');if(btn){btn.textContent=theme==='light'?'☾':'☀';btn.title=theme==='light'?'Usar tema escuro':'Usar tema claro'}syncPlotTheme();if(rerender)renderAll()}
let state={start:0,end:0,preset:'ytd',compare:'yoy'};
function rows(){return months.slice(state.start,state.end+1)}
function labelRange(rs){return rs.length===1?rs[0].label:`${rs[0].label} → ${rs[rs.length-1].label}`}
function totals(rs){const t={gross:sum(rs,'gross'),net:sum(rs,'net'),fixed:sum(rs,'fixed'),cmv:sum(rs,'cmv'),variable:sum(rs,'variable'),expenses:sum(rs,'expenses'),profit:sum(rs,'profit')};t.margin=t.net?t.profit/t.net:0;t.cmvRatio=t.net?t.cmv/t.net:0;t.fixedRatio=t.net?t.fixed/t.net:0;t.variableRatio=t.net?t.variable/t.net:0;return t}
function yoyRows(rs){let out=[];for(const r of rs){const [y,m]=r.key.split('-');const k=`${+y-1}-${m}`;if(!byKey[k])return [];out.push(byKey[k])}return out}
function previousRows(rs){const n=rs.length,s=state.start-n,e=state.start-1;if(s<0||e<0)return [];return months.slice(s,e+1)}
function compRows(rs){return state.compare==='yoy'?yoyRows(rs):previousRows(rs)}
function compLabel(rs,cr){if(!cr.length)return 'sem base comparável completa';return state.compare==='yoy'?`mesmo período do ano anterior (${labelRange(cr)})`:`período anterior (${labelRange(cr)})`}
function delta(a,b){return b? a/b-1:null}
function pp(a,b){return a-b}
function cls(v,inverse=false){if(v===null||!isFinite(v))return 'neutral';const x=inverse?-v:v;return x>.001?'good':x<-.001?'bad':'neutral'}
function deltaText(v,isPP=false){if(v===null||!isFinite(v))return 'Sem base comparável';return `${v>=0?'▲':'▼'} ${isPP?num(Math.abs(v)*100,1)+' p.p.':pct(Math.abs(v),1)}`}
function scoreHealth(t,comp,rs){let s=0;s+=t.margin>=.12?25:t.margin>=.09?21:t.margin>=.06?16:t.margin>=.03?10:t.margin>=0?6:0;s+=t.cmvRatio<=.38?20:t.cmvRatio<=.41?17:t.cmvRatio<=.44?13:t.cmvRatio<=.47?8:3;s+=t.fixedRatio<=.35?20:t.fixedRatio<=.38?16:t.fixedRatio<=.42?12:t.fixedRatio<=.46?8:3;if(comp){const d=delta(t.net,comp.net);s+=d>=.05?20:d>=0?17:d>=-.05?13:d>=-.10?9:d>=-.15?5:2}else s+=10;const pos=rs.filter(r=>r.profit>0).length/Math.max(1,rs.length);s+=Math.round(pos*15);return Math.max(0,Math.min(100,Math.round(s)))}
function status(score){return score>=75?['SAUDÁVEL','var(--green)']:score>=55?['ATENÇÃO','var(--amber)']:['CRÍTICO','var(--red)']}
function spark(el,vals,color){if(!vals.length){el.innerHTML='';return}const W=160,H=34,mi=Math.min(...vals),ma=Math.max(...vals),sp=ma-mi||1,x=i=>i*W/Math.max(1,vals.length-1),y=v=>H-3-(v-mi)/sp*(H-9);const d=vals.map((v,i)=>`${i?'L':'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');el.innerHTML=`<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><path d="${d} L${W},${H} L0,${H} Z" fill="${color}" opacity=".08"/><path d="${d}" fill="none" stroke="${color}" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>`}
function renderTop(rs,t,cr,c){const sc=scoreHealth(t,c,rs),[st,col]=status(sc);$('#score').textContent=sc;$('#score').style.color=col;$('#scoreStatus').textContent=st;$('#scoreStatus').style.color=col;$('#gauge').style.background=`conic-gradient(${col} 0 ${sc*3.6}deg,#172c40 ${sc*3.6}deg 360deg)`;const compTxt=cr.length?`vs ${compLabel(rs,cr)}`:'';
 const ds=[['#kpiNet',t.net,delta(t.net,c?.net),false,false],['#kpiProfit',t.profit,delta(t.profit,c?.profit),false,false],['#kpiMargin',t.margin,pp(t.margin,c?.margin||0),true,false],['#kpiCmv',t.cmvRatio,pp(t.cmvRatio,c?.cmvRatio||0),true,true]];
 $('#kpiNet').textContent=compact(t.net);$('#kpiProfit').textContent=compact(t.profit);$('#kpiProfit').className='value '+(t.profit>=0?'pos':'neg');$('#kpiMargin').textContent=pct(t.margin);$('#kpiCmv').textContent=pct(t.cmvRatio);
 [['#kpiNetDelta',delta(t.net,c?.net),false,false],['#kpiProfitDelta',delta(t.profit,c?.profit),false,false],['#kpiMarginDelta',cr.length?pp(t.margin,c.margin):null,true,false],['#kpiCmvDelta',cr.length?pp(t.cmvRatio,c.cmvRatio):null,true,true]].forEach(([sel,v,isPP,inv])=>{const e=$(sel);e.className='delta '+cls(v,inv);e.textContent=deltaText(v,isPP)+(cr.length?' '+compTxt:'')});
 $('#kpiNetDetail').textContent=`${labelRange(rs)} • ${rs.length} ${rs.length===1?'mês':'meses'}`;$('#kpiProfitDetail').textContent=`Margem acumulada ${pct(t.margin)}`;
 const last=rs[rs.length-1], cushion=last.net-last.breakeven;$('#kpiPe').textContent=compact(last.breakeven);$('#kpiPeDelta').className='delta '+(cushion>=0?'good':'bad');$('#kpiPeDelta').textContent=`${cushion>=0?'▲':'▼'} ${compact(Math.abs(cushion))} ${cushion>=0?'acima':'abaixo'} do PE`;$('#kpiPeDetail').textContent=`Mês final: ${last.label}`;
 const trail=rs.slice(-12);spark($('#sparkNet'),trail.map(x=>x.net),'#4aa3ff');spark($('#sparkProfit'),trail.map(x=>x.profit),'#2bd47d');spark($('#sparkMargin'),trail.map(x=>x.net?x.profit/x.net:0),'#2bd47d');spark($('#sparkCmv'),trail.map(x=>x.net?x.cmv/x.net:0),'#ffad3f');spark($('#sparkPe'),trail.map(x=>x.breakeven),'#a279ff')}
function renderMainChart(rs){const x=rs.map(r=>r.label);const barColors=rs.map(r=>r.profit>=0?'#2bd47d':'#ff5d58');const traces=[
 {type:'bar',name:'LL / PJ',x,y:rs.map(r=>r.profit),marker:{color:barColors,line:{width:0}},opacity:.82,hovertemplate:'<b>%{x}</b><br>LL / PJ: %{y:$,.2f}<extra></extra>'},
 {type:'scatter',mode:'lines+markers',name:'Receita Líquida',x,y:rs.map(r=>r.net),line:{color:'#4aa3ff',width:3},marker:{size:6,color:'#4aa3ff'},hovertemplate:'<b>%{x}</b><br>Receita Líquida: %{y:$,.2f}<extra></extra>'},
 {type:'scatter',mode:'lines+markers',name:'Custos Fixos',x,y:rs.map(r=>r.fixed),line:{color:'#ff8f45',width:2.4},marker:{size:5,color:'#ff8f45'},hovertemplate:'<b>%{x}</b><br>Custos Fixos: %{y:$,.2f}<extra></extra>'},
 {type:'scatter',mode:'lines+markers',name:'CMV',x,y:rs.map(r=>r.cmv),line:{color:'#32c4d8',width:2.4},marker:{size:5,color:'#32c4d8'},hovertemplate:'<b>%{x}</b><br>CMV: %{y:$,.2f}<extra></extra>'},
 {type:'scatter',mode:'lines+markers',name:'Despesas Variáveis',x,y:rs.map(r=>r.variable),line:{color:'#a279ff',width:2.4},marker:{size:5,color:'#a279ff'},hovertemplate:'<b>%{x}</b><br>Despesas Variáveis: %{y:$,.2f}<extra></extra>'}
 ];const lay={...plotBase,barmode:'overlay',xaxis:{...plotBase.xaxis,tickangle:0},yaxis:{...plotBase.yaxis,zeroline:true},margin:{l:65,r:18,t:62,b:45}};Plotly.react('mainChart',traces,lay,plotCfg)}
function insight(icon,title,text,tone){return `<div class="insight"><div class="ii ${tone}">${icon}</div><div><b>${title}</b><p>${text}</p></div></div>`}
function renderInsights(rs,t,cr,c){let arr=[];if(cr.length){const rd=delta(t.net,c.net),pd=delta(t.profit,c.profit),fd=pp(t.fixedRatio,c.fixedRatio),cd=pp(t.cmvRatio,c.cmvRatio),vd=pp(t.variableRatio,c.variableRatio);arr.push(insight(rd>=0?'↗':'↘','Receita '+(rd>=0?'cresceu':'caiu'),`Receita líquida ${deltaText(rd)} versus ${compLabel(rs,cr)}: ${compact(t.net)} contra ${compact(c.net)}.`,rd>=0?'good':'bad'));arr.push(insight(pd>=0?'＋':'−','Resultado '+(pd>=0?'melhorou':'piorou'),`LL/PJ ${deltaText(pd)}. A margem ficou em ${pct(t.margin)} (${deltaText(pp(t.margin,c.margin),true)}).`,pd>=0?'good':'bad'));arr.push(insight(fd<=0?'✓':'!','Peso do custo fixo '+(fd<=0?'melhorou':'aumentou'),`Custos fixos representam ${pct(t.fixedRatio)} da Receita Líquida, ${deltaText(fd,true)} versus a comparação.`,fd<=0?'good':'bad'));arr.push(insight(cd<=0?'✓':'!','CMV '+(cd<=0?'sob controle':'pressionando'),`CMV em ${pct(t.cmvRatio)} da Receita Líquida, ${deltaText(cd,true)} versus a comparação.`,cd<=0?'good':'warn'));if(Math.abs(vd)>.01)arr.push(insight(vd<=0?'✓':'!','Variáveis '+(vd<=0?'mais leves':'mais pesadas'),`Despesas variáveis em ${pct(t.variableRatio)}, ${deltaText(vd,true)} versus a comparação.`,vd<=0?'good':'warn'))}else{const last=rs[rs.length-1],prev=months[idx(last.key)-1];if(prev){const rd=delta(last.net,prev.net),pd=delta(last.profit,prev.profit);arr.push(insight(rd>=0?'↗':'↘','Receita do último mês',`${last.label}: ${compact(last.net)} (${deltaText(rd)} vs ${prev.label}).`,rd>=0?'good':'bad'));arr.push(insight(pd>=0?'＋':'−','Resultado do último mês',`${last.label}: ${compact(last.profit)} (${deltaText(pd)} vs ${prev.label}).`,pd>=0?'good':'bad'))}}
 $('#insights').innerHTML=arr.slice(0,4).join('');const pos=rs.filter(r=>r.profit>0).length;const statusRows=[['Meses com lucro',`${pos}/${rs.length}`,pos/rs.length,'#2bd47d'],['Margem acumulada',pct(t.margin),Math.max(0,Math.min(1,t.margin/.15)),t.margin>=.08?'#2bd47d':'#ffad3f'],['CMV / Receita',pct(t.cmvRatio),Math.max(0,Math.min(1,t.cmvRatio/.50)),t.cmvRatio<=.42?'#2bd47d':'#ffad3f']];$('#miniStatus').innerHTML=statusRows.map(([n,v,w,col])=>`<div><div class="status-row"><span>${n}</span><b>${v}</b></div><div class="meter"><i style="width:${w*100}%;background:${col}"></i></div></div>`).join('')}
function renderCost(rs,t){const vals=[t.fixed,t.cmv,t.variable],labels=['Custos Fixos','CMV','Despesas Variáveis'],colors=['#ff8f45','#32c4d8','#a279ff'];Plotly.react('costDonut',[{type:'pie',hole:.67,labels,values:vals,sort:false,direction:'clockwise',marker:{colors,line:{color:cssVar('--panel'),width:2}},textinfo:'none',hovertemplate:'<b>%{label}</b><br>%{value:$,.2f}<br>%{percent}<extra></extra>'}],{...plotBase,margin:{l:5,r:5,t:5,b:32},showlegend:true,legend:{orientation:'h',x:.5,y:-.02,xanchor:'center',font:{size:9,color:cssVar('--muted')}},annotations:[{text:`<b>${compact(t.expenses)}</b><br><span style="font-size:9px;color:${cssVar('--muted')}">despesas</span>`,x:.5,y:.5,showarrow:false,font:{color:cssVar('--text'),size:13}}]},plotCfg);$('#costKpis').innerHTML=[['Fixo',t.fixed,t.fixedRatio],['CMV',t.cmv,t.cmvRatio],['Variável',t.variable,t.variableRatio]].map(([n,v,r])=>`<div class="cost-kpi"><span>${n}</span><b>${compact(v)}</b><small>${pct(r)} da Receita Líquida</small></div>`).join('')}
function renderRatio(rs){const x=rs.map(r=>r.label),defs=[['Margem Líquida',r=>r.net?r.profit/r.net:0,'#2bd47d'],['CMV / Receita',r=>r.net?r.cmv/r.net:0,'#32c4d8'],['Fixo / Receita',r=>r.net?r.fixed/r.net:0,'#ff8f45'],['Variável / Receita',r=>r.net?r.variable/r.net:0,'#a279ff']];const traces=defs.map(([name,fn,col])=>({type:'scatter',mode:'lines+markers',name,x,y:rs.map(fn),line:{color:col,width:2.4},marker:{size:5,color:col},hovertemplate:`<b>%{x}</b><br>${name}: %{y:.1%}<extra></extra>`}));const lay={...plotBase,margin:{l:50,r:15,t:62,b:40},yaxis:{...plotBase.yaxis,tickprefix:'',tickformat:'.0%',zeroline:true},legend:{...plotBase.legend,y:1.17,font:{size:9,color:cssVar('--muted')}}};Plotly.react('ratioChart',traces,lay,plotCfg)}
function agg(nested,rs){const d={};for(const r of rs){for(const [k,v] of Object.entries(nested[r.key]||{}))d[k]=(d[k]||0)+Number(v||0)}return Object.entries(d).sort((a,b)=>b[1]-a[1])}
function renderList(el,items,color,total){const max=items.length?items[0][1]:1;el.innerHTML=items.slice(0,8).map(([n,v])=>`<div class="list-row"><div><div class="name" title="${String(n).replaceAll('"','&quot;')}">${n}</div><small>${pct(total?v/total:0)} do total</small></div><div class="bar"><i style="width:${Math.max(3,v/max*100)}%;background:${color}"></i></div><b>${compact(v)}</b></div>`).join('')||'<div style="color:var(--muted);font-size:10px">Sem dados no período.</div>'}
function renderDetails(rs,t){renderList($('#groupList'),agg(DATA.groups,rs),'linear-gradient(90deg,#4aa3ff,#32c4d8)',t.expenses);renderList($('#supplierList'),agg(DATA.suppliers,rs),'linear-gradient(90deg,#a279ff,#4aa3ff)',t.expenses);const keys=['debit','credit','pix','cash','delivery','voucher'],labels={debit:'Débito',credit:'Crédito',pix:'Pix',cash:'Dinheiro',delivery:'Delivery',voucher:'Voucher'},colors=['#4aa3ff','#a279ff','#32c4d8','#2bd47d','#ffad3f','#ff6f66'];const vals=keys.map(k=>rs.reduce((s,r)=>s+Number((DATA.receipts[r.key]||{})[k]||0),0));Plotly.react('payChart',[{type:'pie',hole:.62,labels:keys.map(k=>labels[k]),values:vals,sort:false,marker:{colors,line:{color:cssVar('--panel'),width:2}},textinfo:'none',hovertemplate:'<b>%{label}</b><br>%{value:$,.2f}<br>%{percent}<extra></extra>'}],{...plotBase,margin:{l:5,r:5,t:5,b:55},legend:{orientation:'h',x:.5,y:-.06,xanchor:'center',font:{size:9,color:cssVar('--muted')}}},plotCfg)}
function renderLast(rs){const last=rs[rs.length-1],py=byKey[`${+last.key.slice(0,4)-1}-${last.key.slice(5,7)}`],margin=last.net?last.profit/last.net:0,cmv=last.net?last.cmv/last.net:0,fixed=last.net?last.fixed/last.net:0,variable=last.net?last.variable/last.net:0;$('#lastMonthLabel').textContent=`${last.label}${py?' • comparação com '+py.label:''}`;const rows=[['Receita Líquida',compact(last.net),py?deltaText(delta(last.net,py.net)):'—',py?cls(delta(last.net,py.net)):'neutral'],['LL / PJ',compact(last.profit),py?deltaText(delta(last.profit,py.profit)):'—',py?cls(delta(last.profit,py.profit)):'neutral'],['Margem Líquida',pct(margin),py?deltaText(pp(margin,py.profit/py.net),true):'—',py?cls(pp(margin,py.profit/py.net)):'neutral'],['CMV / Receita',pct(cmv),py?deltaText(pp(cmv,py.cmv/py.net),true):'—',py?cls(pp(cmv,py.cmv/py.net),true):'neutral'],['Fixo / Receita',pct(fixed),py?deltaText(pp(fixed,py.fixed/py.net),true):'—',py?cls(pp(fixed,py.fixed/py.net),true):'neutral'],['Variável / Receita',pct(variable),py?deltaText(pp(variable,py.variable/py.net),true):'—',py?cls(pp(variable,py.variable/py.net),true):'neutral']];$('#lastMonthBox').innerHTML=rows.map(([n,v,d,c])=>`<div class="status-row" style="padding:7px 0;border-bottom:1px solid rgba(32,54,75,.65)"><span>${n}</span><div style="text-align:right"><b>${v}</b><div class="delta ${c}" style="font-size:8px">${d}</div></div></div>`).join('')}
function renderDre(rs,t,cr,c){
 $('#drePeriodBadge').textContent=labelRange(rs);
 const headers=rs.map(r=>`<th>${r.label}</th>`).join('')+'<th>ACUMULADO</th>';
 const deductions=r=>r.gross-r.net;
 const grossProfit=r=>r.net-r.cmv;
 const rowTotal=(key)=>sum(rs,key);
 const totalDeductions=t.gross-t.net,totalGrossProfit=t.net-t.cmv;
 const rowsMonthly=[
  {name:'RECEITA BRUTA',fn: